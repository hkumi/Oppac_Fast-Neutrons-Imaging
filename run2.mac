# Accuracy test point: beam at x=20mm, y=0mm, LOW collimator reflectivity
# Same as your clean baseline (5mm collimator, 100um converter, x=20mm)
# but with collimator wall reflectivity dropped from 0.95 (diffuse Teflon)
# to 0.05 (matching the paper's ~5% ABS reflectance), to test whether
# diffuse reflection - not collimator length - is driving the center-bias.
#
# IMPORTANT: ALL /detector/... and /gun/... commands MUST come before
# /run/initialize - geometry is built once and does not rebuild mid-session.
/run/numberOfThreads 4

/detector/setCollimatorLength 5 mm
/detector/setConverterThickness 100 um
/detector/setCollimatorReflectivity 0.05
/gun/setBeamX 20 mm
/gun/setBeamY 0 mm

/run/initialize

/event/verbose 0
/run/printProgress 5
/run/beamOn 10000000

/control/shell mv B4.root B4_x20mm_lowrefl.root
