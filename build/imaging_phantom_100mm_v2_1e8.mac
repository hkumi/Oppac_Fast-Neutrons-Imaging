# Neutron-imaging test, REDONE at corrected scintillation yield, 1e8 events.
# 100mm phantom thickness, 5mm collimator, 100um converter, 0.05
# reflectivity, flood illumination.
/run/numberOfThreads 4

/detector/setCollimatorLength 5 mm
/detector/setConverterThickness 100 um
/detector/setCollimatorReflectivity 0.05
/detector/setScintillationYield 35730000
/detector/setPhantomEnabled 1
/detector/setPhantomThickness 100 mm

/gun/setBeamZ 115 mm
/gun/setBeamSpread 50 mm
/gun/setBeamX 0 mm
/gun/setBeamY 0 mm

/run/initialize

/event/verbose 0
/run/printProgress 5
/run/beamOn 100000000

/control/shell mv B4.root B4_phantom_100mm_v2_1e8.root
